{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed/index.ts",
    "db:studio": "prisma studio",
    "admin:create": "tsx src/cli/admin.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.6",
    "@nestjs/core": "11.2.6",
    "@nestjs/platform-express": "11.2.6",
    "@nestjs/throttler": "6.5.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.44.0",
    "bullmq": "5.81.5",
    "cookie-parser": "1.4.7",
    "dotenv": "17.2.3",
    "helmet": "8.1.0",
    "ioredis": "5.9.2",
    "nodemailer": "9.1.1",
    "pg": "8.17.2",
    "pino": "10.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "shared": "workspace:*",
    "stripe": "20.2.0",
    "zod": "4.3.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/nodemailer": "7.0.9",
    "@types/pg": "8.16.0",
    "prisma": "7.10.0"
  }
}
